# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/socratic_dsa_tutor
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/socratic_dsa_tutor

# JWT & Security
SECRET_KEY=development_insecure_secret_key_change_in_production_32chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini LLM Service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sandbox
SANDBOX_TYPE=development_subprocess
SANDBOX_TIMEOUT_SECONDS=5.0
SANDBOX_MAX_MEMORY_MB=128

# App Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
